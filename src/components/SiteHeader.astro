---
const path = Astro.url.pathname;
const links = [
  // URL stays /writing/ so existing inbound links keep working; the label
  // carries the positioning.
  { href: '/writing/', label: 'field guide' },
  { href: '/about/', label: 'about' },
  { href: '/work/', label: 'work' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="masthead">
  <a class="masthead__name" href="/">Marissa Bellas</a>

  <div class="masthead__tools">
    {/* The theme control stays in the bar rather than inside the menu —
        it is a one-tap toggle and should not need two taps on a phone. */}
    <button class="theme-toggle" type="button" aria-label="Switch theme">
      {/* A half-filled circle: the standard contrast mark, and it reads the
          same in either theme, so it needs no swapping. */}
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
      </svg>
    </button>

    {/* Hidden until the script upgrades the header. Without JavaScript the
        links stay visible and nothing is hidden behind a button that
        cannot open. */}
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      hidden
    >
      <svg class="nav-toggle__bars" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1 4h14M1 8h14M1 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <svg class="nav-toggle__cross" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav class="nav" id="site-nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var header = document.querySelector('.masthead');
    var themeButton = document.querySelector('.theme-toggle');
    var navButton = document.querySelector('.nav-toggle');
    var nav = document.getElementById('site-nav');

    /* ---- theme ---------------------------------------------------- */
    if (themeButton) {
      function current() {
        var set = root.getAttribute('data-theme');
        if (set === 'light' || set === 'dark') return set;
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      function describe() {
        themeButton.setAttribute('aria-label', 'Switch to ' + (current() === 'dark' ? 'light' : 'dark') + ' theme');
      }
      themeButton.setAttribute('data-ready', 'true');
      describe();
      themeButton.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* Storage blocked — the choice still applies for this page view. */
        }
        describe();
      });
      window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function () {
        if (!root.getAttribute('data-theme')) describe();
      });
    }

    /* ---- collapsing nav -------------------------------------------- */
    if (!header || !navButton || !nav) return;

    // Only now does the header start hiding anything, which is why the
    // links are visible by default in the stylesheet.
    header.setAttribute('data-collapsible', 'true');
    navButton.hidden = false;

    function setOpen(open) {
      header.setAttribute('data-open', open ? 'true' : 'false');
      navButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      navButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }
    setOpen(false);

    navButton.addEventListener('click', function () {
      setOpen(navButton.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && navButton.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        navButton.focus();
      }
    });

    document.addEventListener('click', function (e) {
      if (navButton.getAttribute('aria-expanded') !== 'true') return;
      if (!header.contains(e.target)) setOpen(false);
    });

    // Reopening on a wider screen would leave the panel state stale.
    window.matchMedia('(min-width: 40rem)').addEventListener('change', function (e) {
      if (e.matches) setOpen(false);
    });
  })();
</script>
