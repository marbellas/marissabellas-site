---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Subscribe from '../components/Subscribe.astro';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, standfirst, published, updated, kind, tags } = entry.data;

const stamp = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base title={`${title} — Marissa Bellas`} description={standfirst}>
  <article>
    <header class="article-head">
      <h1>{title}</h1>
      <div class="article-head__meta">
        <time datetime={published.toISOString()}>{stamp(published)}</time>
        <span>{kind}</span>
        {updated && <span>updated {stamp(updated)}</span>}
        {tags.length > 0 && <span>{tags.join(', ')}</span>}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <Subscribe />
</Base>
