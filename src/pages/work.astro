---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import zavaThumb from '../content/writing/images/zava-overview.png';

// Add entries as they happen. Delete a section rather than leaving it empty —
// an empty section reads worse than an absent one.
const talks: { title: string; detail: string; href?: string }[] = [
  // {
  //   title: 'Talk title — the argument, not the topic',
  //   detail: 'Venue, date, and one line on the claim you made.',
  //   href: 'https://link-to-slides-or-recording',
  // },
];

const projects = [
  {
    title: 'The State of Zava — security posture dashboard',
    detail:
      'A working prototype for a problem state CISOs actually have: accountability for hundreds of entities they cannot give orders to. Fully synthetic data, single HTML file, no backend.',
    href: 'https://marbellas.github.io/security-dashboard/',
    thumb: zavaThumb,
  },
];

const invitations = [
  'Conference and podcast conversations on security, AI, and what deployment actually costs.',
  'Internal briefings for security teams working through agent governance for the first time.',
  'Reviewing a draft, a reference architecture, or a policy pack before it goes wide.',
];
---

<Base
  title="Work — Marissa Bellas"
  description="Talks, prototypes, and what Marissa Bellas will take an invitation for."
>
  <h1 class="thesis thesis--page">
    <span>Work</span>
  </h1>
  <p class="standfirst hero-fade">
    Things I've built, and what I'll take an invitation for.
  </p>

  <div class="railed">
    <div class="railed__main">
      <section class="section section--flush">
        <h2>What I'll take an invitation for</h2>
        <ul class="stack">
          {
            invitations.map((item) => (
              <li>
                <p>{item}</p>
              </li>
            ))
          }
        </ul>
      </section>

  {
    projects.length > 0 && (
      <section class="section">
        <h2>Projects</h2>
        <ul class="stack">
          {projects.map((item) => (
            <li class="project">
              {item.thumb && (
                <a class="project__thumb" href={item.href} tabindex="-1" aria-hidden="true">
                  <Image
                    src={item.thumb}
                    alt=""
                    widths={[180, 360]}
                    sizes="7.5rem"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="project__body">
                <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                <p>{item.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    talks.length > 0 && (
      <section class="section">
        <h2>Talks</h2>
        <ul class="stack">
          {talks.map((item) => (
            <li>
              <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
              <p>{item.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

    </div>

    <aside class="railed__rail">
      <div class="card">
        <h2 class="card__title">Get in touch</h2>
        <p class="card__body">Speaking, podcasts, and review requests.</p>
        <p class="card__actions">
          <a
            class="button"
            href="mailto:hello@marissabellas.com?subject=Speaking%20invitation"
          >
            Invite me to speak
          </a>
        </p>
        <p class="card__body">
          <a href="mailto:hello@marissabellas.com">hello@marissabellas.com</a>
        </p>
      </div>
    </aside>
  </div>

  <Subscribe />
</Base>
