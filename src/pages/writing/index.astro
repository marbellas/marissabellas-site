---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import Subscribe from '../../components/Subscribe.astro';
import { KINDS, withEntries, showCount } from '../../lib/kinds';

const all = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

// Only sections that actually have something in them. A section with
// nothing published is not rendered at all.
const sections = withEntries(all);
---

<Base
  title="Field guide — Marissa Bellas"
  description="Field notes, patterns, postmortems, and signals on security and AI, organized by what you came for."
>
  <h1 class="thesis thesis--page">
    <span>Field guide</span>
  </h1>
  <p class="standfirst hero-fade">
    Organized by what you came for, not by when I wrote it: a situation, a practice, a failure, or
    something arriving next.
  </p>

  {
    sections.length > 1 && (
      <nav class="jump" aria-label="Sections">
        {sections.map((section) => (
          <a href={`#${KINDS[section.kind].anchor}`}>
            {KINDS[section.kind].plural}
            {showCount(section.entries.length) && (
              <span class="jump__count">{section.entries.length}</span>
            )}
          </a>
        ))}
      </nav>
    )
  }

  {
    sections.map((section) => (
      <section
        class="section"
        id={KINDS[section.kind].anchor}
        style={`--channel: var(--k-${section.kind})`}
      >
        <h2>{KINDS[section.kind].plural}</h2>
        <p class="section__blurb">{KINDS[section.kind].blurb}</p>
        <EntryList entries={section.entries} />
      </section>
    ))
  }

  <Subscribe />
</Base>
