---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import Subscribe from '../components/Subscribe.astro';
import { KINDS, withEntries, showCount } from '../lib/kinds';

const live = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

// One piece is flagged featured; otherwise the newest stands in.
const featured = live.find((e) => e.data.featured) ?? live[0];

// The featured piece is already the loudest thing on the page, so it is
// not repeated in the list below it.
const entries = live.filter((e) => e.id !== featured?.id).slice(0, 5);

// Only sections with something published in them.
const sections = withEntries(live);
---

<Base
  title="Marissa Bellas — a field guide to security and AI"
  description="Field notes, patterns, postmortems, and signals on security and AI — from someone who has deployed it, sold it, and now answers for it."
>
  <div class="lede">
    <div class="lede__copy">
      <h1 class="thesis">
        <span>Deployed it.</span>
        <span>Sold it.</span>
        <span>Now I answer for it.</span>
      </h1>

      <p class="standfirst hero-fade">
        Most writing about security and AI comes from one seat. I have sat in three — delivery,
        then sales, now customer experience — and the view changes more than you would expect
        between them.
      </p>

      <p class="standfirst hero-fade">
        This is a field guide, not a feed. What actually happens when this technology meets a real
        environment: the practices that hold, the mistakes that repeat, and the ones I made myself.
      </p>
    </div>

    {
      featured && (
        <div class="lede__rail hero-fade">
          <FeaturedCard entry={featured} />
        </div>
      )
    }
  </div>

  {
    entries.length > 0 && (
      <section class="section">
        <h2>Most recent</h2>
        <EntryList entries={entries} />
      </section>
    )
  }

  <section class="section">
    <h2>The guide</h2>
    <ul class="rig rig--compact">
      {
        sections.map(({ kind, entries: inKind }) => (
          <li class="rig__row" style={`--channel: var(--k-${kind})`}>
            <p class="rig__head">
              <span class="rig__marker" aria-hidden="true" />
              <a class="rig__name" href={`/writing/#${KINDS[kind].anchor}`}>
                {KINDS[kind].plural}
              </a>
              <span class="rig__leader" aria-hidden="true" />
              {showCount(inKind.length) && <span class="rig__count">{inKind.length}</span>}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <Subscribe />
</Base>
